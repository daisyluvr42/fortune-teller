# 复制此文件为 .env 并填入你的 API Key
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Security / Access Control
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:3000/zh/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/zh
STRIPE_PRICE_ID_BASIC=price_xxx_for_basic_analysis
STRIPE_PRICE_ID_DEEP=price_xxx_for_deep_analysis
STRIPE_PRICE_ID_YEARLY=price_xxx_for_yearly_analysis
CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_ALLOW_CREDENTIALS=true

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
